# Copy this file to .env.compose and replace every example secret.
# SQL Server requires a strong password with at least 8 characters.
MSSQL_SA_PASSWORD=ReplaceWithAStrongAdministratorPassword_456!
DB_PASSWORD=ReplaceWithAStrongApplicationPassword_123!

# Generate at least 32 random bytes and encode them in Base64.
JWT_SECRET=ReplaceWithABase64EncodedSecretOfAtLeast32Bytes
JWT_ISSUER=nextask-api
JWT_ACCESS_TOKEN_TTL=PT1H

OPENAPI_ENABLED=false
APP_PORT=8080
