# Copy this file to .env and replace the example password.
# SQL Server requires at least 8 characters and 3 of these groups:
# uppercase, lowercase, numbers, and symbols.
DB_PASSWORD=ReplaceWithAStrongAppPassword_123!

DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=nextask;encrypt=true;trustServerCertificate=true
DB_USERNAME=nextask_app

# Generate a private Base64 value with at least 32 random bytes.
JWT_SECRET=ReplaceWithABase64EncodedSecretOfAtLeast32Bytes
JWT_ISSUER=nextask-api
JWT_ACCESS_TOKEN_TTL=PT1H

# Keep API documentation enabled locally; disable it in production if desired.
OPENAPI_ENABLED=true
